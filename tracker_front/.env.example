# Use /api with the Vite development proxy. If the backend uses a different
# port, set VITE_API_PROXY_TARGET=http://127.0.0.1:<backend-port>.
# In production, set VITE_API_URL to
# the deployed backend origin followed by /api, for example:
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=/api
